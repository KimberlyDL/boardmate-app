# Copy this file to keystore.properties (same folder) and fill it in.
# keystore.properties is ignored by Git: never commit it or the .jks file.
# The path can be absolute; use forward slashes on Windows.
storeFile=C:/laragon/dormlink-release.jks
storePassword=your-keystore-password
keyAlias=dormlink
keyPassword=your-key-password

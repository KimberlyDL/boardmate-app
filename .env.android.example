# Copy to .env.android. Used by `npm run build:android`, on top of .env.
#
# Where the Android app finds the API:
# - Android emulator, backend on this PC:  http://10.0.2.2:8000/api   (10.0.2.2 = this PC, seen from the emulator)
# - Real phone on the same Wi-Fi:          http://<this PC's Wi-Fi IP>:8000/api
#   (run the backend with: php artisan serve --host=0.0.0.0, and allow port 8000 in Windows Firewall)
# - Release build:                          https://<your server>/api
VITE_API_URL=http://10.0.2.2:8000/api
